#X text 20 570 VELORA AUDIO | VELORA REVERB v1.0 | Professional Reverb Plugin;
#X obj 50 150 hsl 180 15 0 100 0 0 mix_s mix_r Mix -2 -20 0 12 #4d4d4d #ffffff #ffffff 0 1;
#X obj 50 200 hsl 180 15 0 100 0 0 decay_s decay_r Decay -2 -20 0 12 #4d4d4d #ffffff #ffffff 0 1;
#X obj 50 250 hsl 180 15 0 500 0 0 predelay_s predelay_r Predelay -2 -20 0 12 #4d4d4d #ffffff #ffffff 0 1;
