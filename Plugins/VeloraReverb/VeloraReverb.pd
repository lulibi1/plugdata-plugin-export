#X obj 310 250 hsl 180 15 0 100 0 0 damp_s damp_r Damping -2 -20 0 12 #4d4d4d #ffffff #ffffff 0 1;
#X obj 570 150 hsl 180 15 0 100 0 0 glisten_s glisten_r Glisten -2 -20 0 12 #4d4d4d #ffffff #ffffff 0 1;
#X obj 570 200 tgl 40 0 freeze_s freeze_r Freeze 50 0 0 12 #4d4d4d #ffffff #ffffff 0 1;
